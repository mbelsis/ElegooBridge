# The Centauri Carbon. Find both with: python3 -m elegoobridge discover
PRINTER_HOST=192.168.1.50
PRINTER_MAINBOARD_ID=

# What you enter in Bambuddy when adding the printer (model: P1S).
# The serial must be 15 characters; the access code is any password you choose.
BAMBU_SERIAL=0390000ELEGOO01
ACCESS_CODE=changeme
